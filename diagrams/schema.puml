@startuml
skinparam roundcorner 5
skinparam classAttributeIconSize 0
skinparam linetype ortho

entity "UNIT_TYPE" as UNIT_TYPE {
  * unit_type_id : NUMBER <<PK>>
  --
  code : VARCHAR2(10)
  name : VARCHAR2(50)
}

entity "SYSTEM_GROUP" as SYSTEM_GROUP {
  * system_group_id : NUMBER <<PK>>
  --
  parent_group_id : NUMBER <<FK>>
  name : VARCHAR2(100)
  region : VARCHAR2(100)
}

entity "UNIT" as UNIT {
  * unit_id : NUMBER <<PK>>
  --
  unit_type_id : NUMBER <<FK>>
  system_group_id : NUMBER <<FK>>
  call_sign : VARCHAR2(20)
  status : VARCHAR2(20)
  last_position : T_GPS_POSITION <<OBJECT>>
  equipment : T_EQUIPMENT_TAB <<COLLECTION>>
  photo : BLOB
}

entity "OPERATOR" as OPERATOR {
  * operator_id : NUMBER <<PK>>
  --
  system_group_id : NUMBER <<FK>>
  username : VARCHAR2(30)
  role : VARCHAR2(20)
  hire_date : DATE
}

entity "CONTACT" as CONTACT {
  * contact_id : NUMBER <<PK>>
  --
  first_name : VARCHAR2(50)
  last_name : VARCHAR2(50)
  phone_number : VARCHAR2(20)
}

entity "FAULT_REPORT" as FAULT_REPORT {
  * fault_id : NUMBER <<PK>>
  --
  unit_id : NUMBER <<FK>>
  reported_by : NUMBER <<FK>>
  status : VARCHAR2(20)
  reported_at : TIMESTAMP
  resolved_at : TIMESTAMP
}

entity "CASE_FILE" as CASE_FILE {
  * case_id : NUMBER <<PK>>
  --
  created_by : NUMBER <<FK>>
  case_number : VARCHAR2(30)
  opened_at : TIMESTAMP
  closed_at : TIMESTAMP
  status : VARCHAR2(20)
  weather_snapshot : CLOB
}

entity "SHIFT" as SHIFT {
  * shift_id : NUMBER <<PK>>
  --
  operator_id : NUMBER <<FK>>
  shift_date : DATE
  start_time : TIMESTAMP
  end_time : TIMESTAMP
}

entity "CASE_UNIT_ASSIGNMENT" as CASE_UNIT_ASSIGNMENT {
  * assignment_id : NUMBER <<PK>>
  --
  case_id : NUMBER <<FK>>
  unit_id : NUMBER <<FK>>
  dispatched_at : TIMESTAMP
  arrived_at : TIMESTAMP
}

entity "CALL_RECORD" as CALL_RECORD {
  * call_id : NUMBER <<PK>>
  --
  contact_id : NUMBER <<FK>>
  operator_id : NUMBER <<FK>>
  case_id : NUMBER <<FK>>
  call_datetime : TIMESTAMP
  duration_seconds : NUMBER
  status : VARCHAR2(20)
}

entity "ATTACHMENT" as ATTACHMENT {
  * attachment_id : NUMBER <<PK>>
  --
  entity_type : VARCHAR2(20)
  entity_id : NUMBER
  attachment_type : VARCHAR2(20)
  file_content : BLOB
  uploaded_by : NUMBER <<FK>>
}

entity "CASE_NOTE" as CASE_NOTE {
  * note_id : NUMBER <<PK>>
  --
  case_id : NUMBER <<FK>>
  operator_id : NUMBER <<FK>>
  note_text : CLOB
  created_at : TIMESTAMP
}

' Relácie a väzby

UNIT_TYPE "1" ||--o{ "0..*" UNIT : classifies
SYSTEM_GROUP "1" ||--o{ "0..*" UNIT : home_station
SYSTEM_GROUP "1" ||--o{ "0..*" OPERATOR : employs
SYSTEM_GROUP "1" ||--o{ "0..*" SYSTEM_GROUP

UNIT "1" ||--o{ "0..*" FAULT_REPORT : has_fault
OPERATOR "1" ||--o{ "0..*" FAULT_REPORT : reports
OPERATOR "1" ||--o{ "0..*" CASE_FILE : opens
OPERATOR "1" ||--o{ "0..*" SHIFT : works
OPERATOR "1" ||--o{ "0..*" ATTACHMENT : uploads
OPERATOR "1" ||--o{ "0..*" CASE_NOTE : writes

CONTACT "1" ||--o{ "0..*" CALL_RECORD : makes
OPERATOR "1" ||--o{ "0..*" CALL_RECORD : handles
CASE_FILE "1" ||--o{ "0..*" CALL_RECORD : includes

UNIT "1" ||--o{ "0..*" CASE_UNIT_ASSIGNMENT : assigned_to
CASE_FILE "1" ||--o{ "0..*" CASE_UNIT_ASSIGNMENT : contains

CASE_FILE "1" ||--o{ "0..*" ATTACHMENT : has_file
CASE_FILE "1" ||--o{ "0..*" CASE_NOTE : has_note

@enduml